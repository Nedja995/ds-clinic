{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "-v",
            ]
        },
        {
            "name": "Python Debugger: Current File2",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "{workspaceFolder}/src",
            "console": "integratedTerminal",
            "args": [
                "-v",
            ]
        },
        {
            "name": "Python Debugger: Current File3",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "module": "src.main",
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "Python Debugger: GUI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/dsclinic_gui/dsclinic_gui_app.py",
            "console": "integratedTerminal",
            "args": [
                "-v",
            ]
        },
        {
            "name": "Python Debugger: DSClinic",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/dsclinic.py",
            "console": "integratedTerminal"
        }
    ]
}