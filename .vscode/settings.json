{
    "editor.formatOnSave": false,
    "editor.renderWhitespace": "selection",
    "editor.wordWrap": "off",
    "editor.detectIndentation": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.formatOnType": false,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "ms-python.autopep8",
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": { "when": "$(basename).py" },
        "*.exe": true,
        "*.spec": true,
        "dist": true,
        "*.venv": true,
        "**/**/*.egg-info": true,
        "build": true,
        "app_data": true,
        "settings.json": true,
        "LICENSE": true,
        "**/api_claude/**": true,
        "**/db/**": true,
        "**/test_guis/**": true
    },
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "python-envs.defaultEnvManager": "ms-python.python:venv",
    "[python]": {
        "editor.defaultFormatter": "ms-python.autopep8",
        "logging.enabled": true,
        "logging.level": "debug"
    },
    "python.analysis.extraPaths": [
        "./src",
        "./src/**",
        "./src/**/**",
        "./src/**/**/**",
        ".venv/Lib/site-packages",
        "${workspaceFolder}/src",
        "${workspaceFolder}/src/**",
        "${workspaceFolder}/.venv/Lib/site-packages"
    ],
    "autopep8.interpreter": [ "${workspaceFolder}/.venv/Scripts/python.exe" ],
    "autopep8.args": [
            "--max-line-length",
            "500"
    ],
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "geminicodeassist.inlineSuggestions.nextEditPredictions": true,
    "geminicodeassist.inlineSuggestions.suggestionSpeed": "Fast",
    "geminicodeassist.outlines.automaticOutlineGeneration": false,
    "geminicodeassist.project": "278038315476",
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "obsidian-md-vsc.defaultVaultPath": "C:\\NP_DEV\\NP_DEV",
    "obsidian-md-vsc.defaultVault": "NP_DEV",
    "obsidian-md-vsc.buttonClass": [
        "Staa"
    ],
    "python.REPL.enableREPLSmartSend": false
}