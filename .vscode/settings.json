{
    "editor.formatOnSave": false,
    "editor.renderWhitespace": "selection",
    "editor.wordWrap": "off",
    "editor.detectIndentation": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.formatOnType": false,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "ms-python.autopep8",

    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "python-envs.defaultEnvManager": "ms-python.python:venv",
    "[python]": {
        "editor.defaultFormatter": "ms-python.autopep8",
        "logging.enabled": true,
        "logging.level": "debug"
    },
    "python.analysis.extraPaths": [
        "./src",
        "./src/**",
        "./src/**/**",
        "./src/**/**/**",
        ".venv/Lib/site-packages",
        "${workspaceFolder}/src",
        "${workspaceFolder}/src/**",
        "${workspaceFolder}/.venv/Lib/site-packages"
    ],

    "autopep8.interpreter": [ "${workspaceFolder}/.venv/Scripts/python.exe" ],
    "autopep8.args": [
            "--max-line-length",
            "500"
    ],
    "geminicodeassist.inlineSuggestions.nextEditPredictions": true,
    "geminicodeassist.inlineSuggestions.suggestionSpeed": "Fast",
    "geminicodeassist.outlines.automaticOutlineGeneration": false,
    "geminicodeassist.project": "278038315476",
}