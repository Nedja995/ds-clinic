{
    "json.schemas": [
        {
            "fileMatch": [
                "**/markdownlint.json",
                "**/markdownlint.jsonc",
                "**/.markdownlint.json",
                "**/.markdownlint.jsonc"
            ],
            "url": "https://raw.githubusercontent.com/DavidAnson/markdownlint/v0.40.0/schema/markdownlint-config-schema.json"
        }
    ],
    "python.logging.level": "DEBUG",
    "python.logging.enabled": true,
    "python.analysis.extraPaths": [
        "./src",
        "./src/**",
        "./src/**/**",
        "./src/**/**/**",
        ".venv/Lib/site-packages",
        "${workspaceFolder}/src",
        "${workspaceFolder}/src/**",
        "${workspaceFolder}/.venv/Lib/site-packages"
    ],
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "autopep8.interpreter": [
            "${workspaceFolder}/.venv/Scripts/python.exe"
        ],
    "[python]": {
        "editor.defaultFormatter": "ms-python.autopep8",
        "logging.level": "DEBUG",
        "python.logging.enabled": true,
    },
    "autopep8.args": [
        "--max-line-length",
        "500"
    ],

    "geminicodeassist.chat.changeView": "Default diff view",
    "geminicodeassist.customCommands": {
        "add-comment": "add some comments to my code"
    },
    "geminicodeassist.enableTelemetry": false,
    "geminicodeassist.inlineSuggestions.nextEditPredictions": true,
    "geminicodeassist.outlines.automaticOutlineGeneration": false,
    "geminicodeassist.project": "278038315476",
    "geminicodeassist.inlineSuggestions.suggestionSpeed": "Fast",
    "python-envs.defaultEnvManager": "ms-python.python:venv",
}